# Server Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/frametrail
JWT_SECRET=super_secret_jwt_token_key_frametrail_2026
JWT_EXPIRES_IN=7d
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_verified_sender@example.com

# Cloudflare R2 / AWS S3 Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=frametrail-media
R2_PUBLIC_DOMAIN=https://pub-yourdomain.r2.dev

# Client Environment Variables
VITE_API_BASE_URL=http://localhost:5000/api
